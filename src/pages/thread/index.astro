---
import Thread from '../../layouts/Thread.astro';
import { allWorks, byYear, thumb, full, label } from '../../lib/works.js';
import { artist, statement } from '../../data/site.js';
const groups = byYear();
---
<Thread description={statement}>
  <button slot="nav" type="button" id="index-toggle" aria-pressed="false">index</button>

  <main>
    <section class="opening">
      <p class="statement">{statement.split('. ')[0]}.</p>
      <p class="date-note">This arrangement was made on <span id="today">today’s date</span>. It will be different tomorrow. Follow the thread.</p>
    </section>

    <div class="surface" id="surface">
      <svg class="thread" id="thread" aria-hidden="true">
        <defs>
          <mask id="reveal" maskUnits="userSpaceOnUse">
            <path id="reveal-path" fill="none" stroke="#fff" stroke-width="8" />
          </mask>
        </defs>
        <path id="stitch" fill="none" mask="url(#reveal)" />
      </svg>
      <ol class="pieces" aria-label="Works">
        {allWorks.map((w) => (
          <li class="piece" data-id={w.id} data-w={w.width} data-h={w.height}>
            <a href={`/thread/work/${w.id}/`} data-full={full(w)} data-label={label(w)}>
              <img src={thumb(w)} alt={w.alt} loading="lazy" width={w.width} height={w.height} style={`background:${w.color}`} />
              <span class="label">{label(w)}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <section class="index" id="index" hidden>
      <h1>Index</h1>
      {groups.map(([year, works]) => (
        <div class="index-year">
          <h2>{year}</h2>
          <ul>
            {works.map((w) => <li><a href={`/thread/work/${w.id}/`}>{label(w)}</a></li>)}
          </ul>
        </div>
      ))}
      <hr class="stitch-rule" />
      <p><a href="/thread/about/">About, statement, exhibitions, contact</a> · <a href={artist.instagram}>Instagram</a></p>
    </section>
  </main>

  <dialog id="lift" aria-label="Artwork">
    <figure>
      <img id="lift-img" alt="" />
      <figcaption>
        <span id="lift-label"></span>
        <span class="lift-links">
          <a id="lift-card" href="#">send as postcard</a>
          <a id="lift-inquire" href="#">inquire</a>
          <button type="button" id="lift-close">close</button>
        </span>
      </figcaption>
    </figure>
  </dialog>
</Thread>

<style>
  main { padding: 96px var(--gutter) 160px; }
  .opening { max-width: 640px; margin: 8vh auto 10vh; text-align: center; }
  .statement { font: 300 italic clamp(24px, 3.4vw, 38px)/1.35 var(--serif); margin: 0 0 24px; }
  .date-note { color: var(--muted); font-size: 12px; }

  .surface { position: relative; max-width: 1280px; margin: 0 auto; }
  .thread { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 0; }
  #stitch { stroke: var(--thread); stroke-width: 2; stroke-dasharray: 10 7; stroke-linecap: round; }

  /* Without JS the pieces stack in a simple column. */
  .pieces { list-style: none; margin: 0; padding: 0; display: grid; gap: 48px; justify-items: center; }
  .piece { width: min(420px, 100%); position: relative; z-index: 1; }
  .piece a { display: block; text-decoration: none; background: var(--card); padding: 10px 10px 0; box-shadow: 0 1px 1px rgb(60 40 20 / 0.12), 0 12px 24px -10px rgb(60 40 20 / 0.35); transition: transform 0.25s, box-shadow 0.25s; }
  .piece a:hover { transform: translateY(-4px) rotate(0deg) !important; box-shadow: 0 2px 2px rgb(60 40 20 / 0.12), 0 22px 36px -12px rgb(60 40 20 / 0.45); }
  .piece img { width: 100%; height: auto; }
  .label { display: block; padding: 8px 2px 10px; font-size: 11px; color: var(--muted); }
  .piece::before { /* pin */
    content: ''; position: absolute; top: -5px; left: 50%; width: 10px; height: 10px; margin-left: -5px; z-index: 2;
    border-radius: 50%; background: radial-gradient(circle at 35% 35%, #e0656b, var(--thread) 60%, #6e1219);
    box-shadow: 0 2px 3px rgb(0 0 0 / 0.3);
  }
  .piece.seen a { filter: saturate(0.55) brightness(1.04); }

  .laid-out .pieces { display: block; }
  .laid-out .piece { position: absolute; }

  .index { max-width: 720px; margin: 0 auto; }
  .index h1 { font: 300 italic 40px var(--serif); margin: 0 0 24px; }
  .index h2 { font-size: 12px; color: var(--thread); margin: 32px 0 8px; font-weight: 500; }
  .index ul { list-style: none; padding: 0; margin: 0; columns: 2 200px; }
  .index li { padding: 2px 0; }
  .index a { text-decoration: none; }
  .index a:hover { color: var(--thread); text-decoration: underline dashed; }

  dialog { border: 0; padding: 0; background: transparent; max-width: min(1100px, 100vw - 32px); max-height: 100vh; overflow: visible; }
  dialog::backdrop { background: rgb(38 34 30 / 0.72); }
  dialog[open] figure { animation: lift 0.35s cubic-bezier(.2,.8,.2,1); }
  dialog figure { margin: 0; background: var(--card); padding: 14px 14px 0; box-shadow: 0 30px 60px rgb(0 0 0 / 0.4); }
  dialog img { max-height: calc(100vh - 140px); width: auto; margin: 0 auto; }
  dialog figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding: 12px 2px 14px; font-size: 12px; }
  .lift-links { display: flex; gap: 16px; }
  .lift-links a, .lift-links button { font: inherit; color: var(--thread); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline dashed; text-underline-offset: 3px; }
  @keyframes lift { from { transform: translateY(24px) scale(0.96) rotate(-1deg); opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .piece a, dialog[open] figure { transition: none; animation: none; }
  }
</style>

<script>
  const surface = document.getElementById('surface')!;
  const list = surface.querySelector('.pieces') as HTMLElement;
  const pieces = [...list.querySelectorAll<HTMLElement>('.piece')];
  const stitch = document.getElementById('stitch') as unknown as SVGPathElement;
  const reveal = document.getElementById('reveal-path') as unknown as SVGPathElement;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- A seed that changes once a day ---
  const today = new Date();
  const dayKey = today.toISOString().slice(0, 10);
  document.getElementById('today')!.textContent = today.toLocaleDateString('en-CA', { day: 'numeric', month: 'long', year: 'numeric' });
  let seed = [...dayKey].reduce((h, c) => Math.imul(h ^ c.charCodeAt(0), 2654435761), 1);
  const rand = () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  const between = (a: number, b: number) => a + rand() * (b - a);

  // Shuffle once per day; keep order in the DOM so tab order follows the thread.
  for (let i = pieces.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1));
    [pieces[i], pieces[j]] = [pieces[j], pieces[i]];
  }
  pieces.forEach((p) => list.appendChild(p));
  const angles = pieces.map(() => between(-3.5, 3.5));
  const sizes = pieces.map(() => rand());
  const offsets = pieces.map(() => rand());

  // --- Layout: pieces alternate sides, pinned; the thread runs pin to pin ---
  let pins: { x: number; y: number }[] = [];
  function layout() {
    const W = surface.clientWidth;
    const narrow = W < 700;
    let y = 0;
    let side = 0;
    pins = [];
    pieces.forEach((p, i) => {
      const w = narrow ? W * (0.62 + sizes[i] * 0.22) : W * (0.24 + sizes[i] * 0.16);
      const ratio = Number(p.dataset.h) / Number(p.dataset.w);
      const h = w * ratio + 40;
      const half = (W - w) / 2;
      const x = side === 0 ? offsets[i] * half * 0.9 : half + offsets[i] * half;
      p.style.width = `${w}px`;
      p.style.left = `${x}px`;
      p.style.top = `${y}px`;
      p.style.transform = `rotate(${angles[i]}deg)`;
      pins.push({ x: x + w / 2, y: y });
      y += h * (narrow ? 1 : between(0.5, 0.7)) + 24;
      side = 1 - side;
    });
    const last = pieces[pieces.length - 1];
    surface.style.height = `${y + last.offsetHeight}px`;
    surface.classList.add('laid-out');
    drawThread();
  }

  function drawThread() {
    let d = `M ${pins[0].x} ${pins[0].y - 60}`;
    let prev = { x: pins[0].x, y: pins[0].y - 60 };
    for (const pt of pins) {
      // Each span sags below the straight line, like thread hanging between pins.
      const sag = Math.min(140, Math.abs(pt.x - prev.x) * 0.35 + 40);
      d += ` C ${prev.x} ${prev.y + sag}, ${pt.x} ${pt.y - sag * 0.4}, ${pt.x} ${pt.y}`;
      prev = pt;
    }
    stitch.setAttribute('d', d);
    reveal.setAttribute('d', d);
    const len = reveal.getTotalLength();
    reveal.style.strokeDasharray = `${len}`;
    reveal.dataset.len = String(len);
    onScroll();
  }

  // --- The thread is drawn ahead of the reader as they scroll ---
  function onScroll() {
    const len = Number(reveal.dataset.len);
    if (reduceMotion) { reveal.style.strokeDashoffset = '0'; return; }
    const top = surface.getBoundingClientRect().top + scrollY;
    const reach = scrollY + innerHeight * 0.85 - top;
    // Find how far along the path the reader's viewport reaches.
    const idx = pins.findIndex((p) => p.y > reach);
    const fraction = idx === -1 ? 1 : Math.max(0, idx / pins.length);
    reveal.style.strokeDashoffset = `${len * (1 - fraction)}`;
  }

  layout();
  addEventListener('scroll', onScroll, { passive: true });
  let resizeTimer: number;
  addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = window.setTimeout(layout, 150); });
  // Lazy images do not change size (width/height attributes), so layout holds.

  // --- Works already looked at are marked on return visits (this browser only) ---
  const SEEN = 'mb-seen';
  let seen: string[] = [];
  try { seen = JSON.parse(localStorage.getItem(SEEN) || '[]'); } catch {}
  pieces.forEach((p) => { if (seen.includes(p.dataset.id!)) p.classList.add('seen'); });
  const markSeen = (id: string) => {
    if (seen.includes(id)) return;
    seen.push(id);
    try { localStorage.setItem(SEEN, JSON.stringify(seen)); } catch {}
  };

  // --- Lifting a work off the surface ---
  const dialog = document.getElementById('lift') as HTMLDialogElement;
  const liftImg = document.getElementById('lift-img') as HTMLImageElement;
  list.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    const piece = a.closest('.piece') as HTMLElement;
    const img = a.querySelector('img')!;
    liftImg.src = a.dataset.full!;
    liftImg.alt = img.alt;
    document.getElementById('lift-label')!.textContent = a.dataset.label!;
    (document.getElementById('lift-card') as HTMLAnchorElement).href = a.getAttribute('href')!;
    (document.getElementById('lift-inquire') as HTMLAnchorElement).href = `/thread/about/?work=${piece.dataset.id}#contact`;
    dialog.showModal();
    markSeen(piece.dataset.id!);
  });
  document.getElementById('lift-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  // --- Index: a plain list of everything ---
  const toggle = document.getElementById('index-toggle')!;
  const index = document.getElementById('index')!;
  const opening = document.querySelector('.opening') as HTMLElement;
  toggle.addEventListener('click', () => {
    const show = index.hidden;
    index.hidden = !show;
    surface.hidden = show;
    opening.hidden = show;
    toggle.setAttribute('aria-pressed', String(show));
    toggle.textContent = show ? 'surface' : 'index';
    scrollTo(0, 0);
    if (!show) layout();
  });
</script>
