---
import Thread from '../../../layouts/Thread.astro';
import { allWorks, full, thumb, label, neighbours } from '../../../lib/works.js';
import { artist } from '../../../data/site.js';

export function getStaticPaths() {
  return allWorks.map((w) => ({ params: { id: w.id }, props: { work: w } }));
}
const { work } = Astro.props;
const { prev, next } = neighbours(work.id);
---
<Thread title={label(work)} description={`${label(work)} by ${artist.name}.`} image={full(work)}>
  <main>
    <div class="card" id="card">
      <div class="face front">
        <img src={full(work)} alt={work.alt} width={work.width} height={work.height} style={`background:${work.color}`} />
      </div>
      <div class="face back" aria-label="Back of the postcard">
        <div class="message">
          <label for="msg">Message</label>
          <textarea id="msg" maxlength="280" placeholder="Write a few words to send with this work…"></textarea>
          <p class="received" id="received" hidden></p>
        </div>
        <div class="address">
          <div class="stamp"><img src={thumb(work)} alt="" /></div>
          <div class="postmark">Vancouver<br />{work.year}</div>
          <p class="typed">
            {work.title}, {work.year}<br />
            {work.medium ?? 'medium to be added'}<br />
            {work.dimensions ?? 'dimensions to be added'}<br />
            {artist.name}
          </p>
        </div>
      </div>
    </div>

    <div class="controls">
      <button type="button" id="flip">turn over</button>
      <button type="button" id="send">send as postcard</button>
      <a href={`/thread/about/?work=${work.id}#contact`}>inquire</a>
      <span id="status" role="status"></span>
    </div>

    <nav class="pager" aria-label="More work">
      <a href={`/thread/work/${prev.id}/`}>← previous</a>
      <a href="/thread/">back to the surface</a>
      <a href={`/thread/work/${next.id}/`}>next →</a>
    </nav>
  </main>
</Thread>

<style>
  main { padding: 96px var(--gutter) 120px; max-width: 980px; margin: 0 auto; }
  .card { position: relative; perspective: 1600px; display: grid; }
  .face { grid-area: 1 / 1; background: var(--card); padding: 16px; box-shadow: 0 2px 2px rgb(60 40 20 / 0.12), 0 24px 48px -16px rgb(60 40 20 / 0.45); backface-visibility: hidden; transition: transform 0.7s cubic-bezier(.3,.7,.2,1); }
  .front img { max-height: 76vh; width: auto; margin: 0 auto; }
  .back { transform: rotateY(180deg); display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .card.flipped .front { transform: rotateY(-180deg); }
  .card.flipped .back { transform: rotateY(0deg); }

  .message { padding: 16px 24px 16px 8px; border-right: 1px dashed var(--muted); display: flex; flex-direction: column; }
  .message label { font-size: 11px; color: var(--muted); margin-bottom: 8px; }
  textarea { flex: 1; min-height: 200px; resize: none; border: 0; background: repeating-linear-gradient(transparent 0 31px, #d9d1c3 31px 32px); font: 300 italic 20px/32px var(--serif); color: var(--ink); padding: 0; }
  textarea:focus { outline: none; }
  .received { font: 300 italic 22px/1.5 var(--serif); margin: 0; }

  .address { position: relative; padding: 16px 8px 16px 24px; display: flex; flex-direction: column; justify-content: flex-end; min-height: 300px; }
  .stamp { position: absolute; top: 16px; right: 8px; width: 84px; padding: 5px; background: #fff; outline: 2px dotted var(--paper-deep); outline-offset: -1px; }
  .stamp img { aspect-ratio: 1; object-fit: cover; }
  .postmark { position: absolute; top: 36px; right: 72px; width: 84px; height: 84px; border: 2px solid rgb(176 36 44 / 0.55); border-radius: 50%; display: grid; place-items: center; text-align: center; font-size: 10px; line-height: 1.3; color: rgb(176 36 44 / 0.75); transform: rotate(-14deg); }
  .typed { margin: 0; font-size: 13px; line-height: 2.2; border-top: 1px solid #d9d1c3; }

  .controls { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 28px; font-size: 13px; }
  .controls button, .controls a { font: inherit; color: var(--thread); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline dashed; text-underline-offset: 3px; }
  #status { color: var(--muted); }

  .pager { display: flex; justify-content: space-between; margin-top: 64px; font-size: 12px; }
  .pager a { text-decoration: none; color: var(--muted); }
  .pager a:hover { color: var(--thread); }

  @media (max-width: 640px) {
    .back { grid-template-columns: 1fr; }
    .message { border-right: 0; border-bottom: 1px dashed var(--muted); padding: 8px 0 16px; }
    .address { padding: 16px 0 0; min-height: 220px; }
  }
  @media (prefers-reduced-motion: reduce) { .face { transition: none; } }
</style>

<script>
  const card = document.getElementById('card')!;
  const flip = document.getElementById('flip')!;
  const msg = document.getElementById('msg') as HTMLTextAreaElement;
  const status = document.getElementById('status')!;

  const setFlipped = (on: boolean) => {
    card.classList.toggle('flipped', on);
    flip.textContent = on ? 'turn back' : 'turn over';
  };
  flip.addEventListener('click', () => setFlipped(!card.classList.contains('flipped')));

  // A received postcard opens on its message side.
  const received = new URLSearchParams(location.search).get('m');
  if (received) {
    const p = document.getElementById('received')!;
    p.textContent = received;
    p.hidden = false;
    msg.hidden = true;
    document.querySelector('.message label')!.textContent = 'Someone sent you this';
    setFlipped(true);
  }

  document.getElementById('send')!.addEventListener('click', async () => {
    if (!card.classList.contains('flipped')) { setFlipped(true); msg.focus(); status.textContent = 'Write a message, then send.'; return; }
    const url = new URL(location.pathname, location.origin);
    if (msg.value.trim()) url.searchParams.set('m', msg.value.trim());
    try {
      if (navigator.share) await navigator.share({ title: document.title, url: url.href });
      else { await navigator.clipboard.writeText(url.href); status.textContent = 'Link copied. Paste it anywhere to send.'; }
    } catch { status.textContent = url.href; }
  });
</script>
