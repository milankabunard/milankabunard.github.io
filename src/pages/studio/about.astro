---
import Studio from '../../layouts/Studio.astro';
import { artist, bio, statement, collections, exhibitions } from '../../data/site.js';
---
<Studio title="About" description={bio[0]}>
  <div class="about">
    <section>
      <h1>About</h1>
      {bio.map((p) => <p>{p}</p>)}
      <p class="muted">Work in collections in {collections.join(', ')}.</p>
    </section>

    <section id="statement">
      <h2>Statement</h2>
      <blockquote>{statement}</blockquote>
    </section>

    <section id="exhibitions">
      <h2>Selected exhibitions</h2>
      <ul class="shows">
        {exhibitions.map((e) => (
          <li>
            <span class="year">{e.year}</span>
            <span><strong>{e.title}</strong><br />{e.venue}, {e.place}<br /><small>{e.note}</small></span>
          </li>
        ))}
      </ul>
    </section>

    <section id="contact">
      <h2>Contact</h2>
      <p>For private viewings, studio visits and inquiries about available work.</p>
      <!-- Placeholder: wire to Formspree (or similar) before launch. -->
      <form class="contact" action="#" method="post">
        <label>Name <input name="name" autocomplete="name" required /></label>
        <label>Email <input name="email" type="email" autocomplete="email" required /></label>
        <label>Work (optional) <input name="work" id="work-field" /></label>
        <label>Message <textarea name="message" rows="5" required></textarea></label>
        <button class="button" type="submit">Send</button>
      </form>
      <p class="muted">Or message on <a class="text-link" href={artist.instagram}>Instagram</a>. Open studio during the <a class="text-link" href={artist.cultureCrawl}>Eastside Culture Crawl</a>.</p>
    </section>
  </div>
  <script>
    const work = new URLSearchParams(location.search).get('work');
    const field = document.getElementById('work-field') as HTMLInputElement | null;
    if (work && field) field.value = work;
  </script>
</Studio>

<style>
  .about { max-width: 720px; padding-top: 32px; }
  h1 { font-size: clamp(40px, 6vw, 72px); margin-bottom: 32px; }
  h2 { font-size: 30px; margin: 96px 0 24px; }
  section { scroll-margin-top: 80px; }
  p { font-size: 17px; }
  .muted { color: var(--muted); font-size: 15px; }
  blockquote { margin: 0; font: 300 italic 24px/1.5 var(--serif); }
  .shows { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .shows li { display: grid; grid-template-columns: 72px 1fr; padding: 18px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .shows .year { color: var(--muted); }
  .shows strong { font-weight: 500; }
  .shows small { color: var(--muted); font-size: 13px; }
  .contact { display: grid; gap: 18px; margin: 24px 0; }
  .contact label { display: grid; gap: 6px; font-size: 13px; color: var(--muted); }
  .contact input, .contact textarea { font: inherit; font-size: 16px; color: var(--ink); padding: 10px 12px; background: #fff; border: 1px solid var(--line); border-radius: 0; }
  .contact input:focus, .contact textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .contact button { justify-self: start; background: none; cursor: pointer; font: inherit; font-size: 14px; color: var(--ink); }
</style>
