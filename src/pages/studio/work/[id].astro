---
import Studio from '../../../layouts/Studio.astro';
import { allWorks, full, label, neighbours } from '../../../lib/works.js';
import { artist } from '../../../data/site.js';

export function getStaticPaths() {
  return allWorks.map((w) => ({ params: { id: w.id }, props: { work: w } }));
}
const { work } = Astro.props;
const { prev, next } = neighbours(work.id);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: work.title,
  dateCreated: String(work.year),
  image: new URL(full(work), Astro.site).href,
  creator: { '@type': 'Person', name: artist.name },
};
---
<Studio title={label(work)} description={`${label(work)} by ${artist.name}.`} image={full(work)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="work">
    <figure>
      <img src={full(work)} alt={work.alt} width={work.width} height={work.height} style={`background:${work.color}`} />
    </figure>
    <div class="details">
      <h1>{work.title}</h1>
      <dl>
        <dt>Year</dt><dd>{work.year}</dd>
        <dt>Medium</dt><dd>{work.medium ?? 'To be added'}</dd>
        <dt>Dimensions</dt><dd>{work.dimensions ?? 'To be added'}</dd>
        <dt>Availability</dt><dd>{work.availability ?? 'Inquire'}</dd>
      </dl>
      <a class="button" href={`/studio/about/?work=${work.id}#contact`}>Inquire about this work</a>
    </div>
  </article>
  <nav class="pager" aria-label="More work">
    <a href={`/studio/work/${prev.id}/`}>← Previous</a>
    <a href="/studio/work/">All work</a>
    <a href={`/studio/work/${next.id}/`}>Next →</a>
  </nav>
</Studio>

<style>
  .work { display: grid; grid-template-columns: minmax(0, 3fr) minmax(240px, 1fr); gap: 48px; align-items: start; padding-top: 24px; }
  figure { margin: 0; }
  figure img { width: 100%; height: auto; max-height: 84vh; object-fit: contain; object-position: left top; }
  .details { position: sticky; top: 96px; }
  .details h1 { font-size: 36px; margin-bottom: 24px; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 10px 20px; margin: 0 0 32px; font-size: 14px; }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .pager { display: flex; justify-content: space-between; margin-top: 64px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 14px; }
  .pager a { text-decoration: none; color: var(--muted); }
  .pager a:hover { color: var(--ink); }
  @media (max-width: 760px) { .work { grid-template-columns: 1fr; gap: 24px; } .details { position: static; } }
</style>
