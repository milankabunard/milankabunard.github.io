---
import Studio from '../../../layouts/Studio.astro';
import { allWorks, byYear, thumb, label } from '../../../lib/works.js';
const groups = byYear();
---
<Studio title="Work" description={`${allWorks.length} works by Milanka Bunard, 2015 to the present.`}>
  <header class="page-head">
    <h1>Work</h1>
    <nav class="years" aria-label="Years">
      {groups.map(([year]) => <a href={`#y${year}`}>{year}</a>)}
    </nav>
  </header>

  {groups.map(([year, works]) => (
    <section id={`y${year}`} class="year">
      <h2>{year} <span>{works.length} {works.length === 1 ? 'work' : 'works'}</span></h2>
      <ul class="masonry">
        {works.map((w) => (
          <li>
            <a href={`/studio/work/${w.id}/`}>
              <img src={thumb(w)} alt={w.alt} loading="lazy" width={w.width} height={w.height} style={`background:${w.color}`} />
              <span>{label(w)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Studio>

<style>
  .page-head { padding: 32px 0 16px; }
  .page-head h1 { font-size: clamp(40px, 6vw, 72px); }
  .years { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 20px; font-size: 14px; }
  .years a { color: var(--muted); text-decoration: none; }
  .years a:hover { color: var(--accent); }

  .year { scroll-margin-top: 80px; }
  .year h2 { font-size: 28px; margin: 80px 0 24px; padding-top: 16px; border-top: 1px solid var(--line); }
  .year h2 span { font: 400 13px var(--sans); color: var(--muted); margin-left: 12px; }

  .masonry { list-style: none; margin: 0; padding: 0; columns: 4 220px; column-gap: 24px; }
  .masonry li { break-inside: avoid; margin-bottom: 32px; }
  .masonry a { text-decoration: none; }
  .masonry img { width: 100%; height: auto; transition: opacity 0.2s; }
  .masonry a:hover img { opacity: 0.85; }
  .masonry span { display: block; margin-top: 8px; font-size: 13px; color: var(--muted); }
</style>
