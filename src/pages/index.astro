---
import { allWorks, thumb } from '../lib/works.js';
const a = allWorks[3];
const b = allWorks.find((w) => w.year === 2018) ?? allWorks[10];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Milanka Bunard · Design directions</title>
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #1a1a1a; color: #eee; font: 16px/1.5 system-ui, sans-serif; }
    main { width: min(900px, 100% - 32px); padding: 48px 0; }
    h1 { font-weight: 500; font-size: 20px; margin: 0 0 4px; }
    p { color: #999; margin: 0 0 32px; }
    .choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
    a { color: inherit; text-decoration: none; display: block; border: 1px solid #333; border-radius: 8px; overflow: hidden; }
    a:hover { border-color: #888; }
    img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
    span { display: block; padding: 14px 16px; }
    small { display: block; color: #999; }
  </style>
</head>
<body>
  <main>
    <h1>Milanka Bunard — two design directions</h1>
    <p>Skeleton prototypes using Instagram images. Titles and details are placeholders.</p>
    <div class="choices">
      <a href="/studio/"><img src={thumb(a)} alt="" /><span>A · Studio<small>Conventional structure, quiet design, built for search and familiarity.</small></span></a>
      <a href="/thread/"><img src={thumb(b)} alt="" /><span>B · Thread<small>One paper surface, works joined by a stitched thread, layout changes daily.</small></span></a>
    </div>
  </main>
</body>
</html>
